{
  "approvalPolicy": {
    "default": "manual",
    "rules": [
      {
        "maxDepth": 2,
        "then": "auto"
      }
    ]
  },
  "memoryConsolidateModel": "anthropic/claude-haiku-4-5",
  "execAllowlist": [
    "bun test",
    "bun run typecheck",
    "git status",
    "git diff",
    "git log",
    "git show",
    "git grep",
    "git ls-files",
    "git rev-parse",
    "git merge-base",
    "grep"
  ],
  "mcpServers": {
    "web": {
      "command": "bun",
      "args": [
        "/home/yanneck/Work/orchestrator/plugins/mcp-client/src/web-mcp.ts"
      ],
      "env": {
        "TAVILY_API_KEY": "$TAVILY_API_KEY"
      }
    }
  },
  "memoryEmbedModel": "ollama/mxbai-embed-large",
  "maxIterations": 60,
  "autoCommit": true,
  "workspaceSetup": [
    "bun",
    "install",
    "--frozen-lockfile"
  ]
}
