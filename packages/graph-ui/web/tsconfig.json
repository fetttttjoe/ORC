{
  "compilerOptions": {
    // ES2024, not ES2022: @orc/contracts is compiled at ESNext and its code is BUNDLED into this
    // app, so the browser already has to run whatever it uses (Map.groupBy today). A lower `lib`
    // here does not make the output safer — it only hides from the typechecker what ships anyway.
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
  // Vendored shadcn-svelte under src/lib/components/ui is NOT excluded here on purpose: measured,
  // svelte-check ignores `exclude` and walks every file it finds anyway (190 files either way).
  // The vendored noise is filtered at the reporting layer instead — scripts/check-web.ts.
  //
  // src/**/*.test.ts stays excluded — checked 2026-09-18: NOT a one-line fix. Including test files
  // needs "bun" added to `types` first (bare `bun:test` otherwise fails to resolve), and once
  // added, 10 pre-existing errors surface in colors.test.ts, plan-edit.test.ts and
  // plan-geometry.test.ts ("no overload matches this call") — real, and unrelated to whatever
  // change is being made when this comment is read.
  "exclude": ["src/**/*.test.ts"]
}
