{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["svelte", "vite/client"],
    "paths": { "$lib": ["./src/lib"], "$lib/*": ["./src/lib/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
  // Vendored shadcn-svelte under src/lib/components/ui is NOT excluded here on purpose: measured,
  // svelte-check ignores `exclude` and walks every file it finds anyway (190 files either way).
  // The vendored noise is filtered at the reporting layer instead — scripts/check-web.ts.
  "exclude": ["src/**/*.test.ts"]
}
